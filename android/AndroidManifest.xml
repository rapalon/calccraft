<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app: Android's NativeActivity loads libcalculator.so (the Rust library, see
     src/lib.rs) and its android_main runs the app. There is no Java code. build-apk.ps1 adds
     the version from Cargo.toml (see README.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rapalon.calccraft">

    <!-- The keys' tap of the vibration motor (Settings → Key vibration, android.rs key_tap).
         A normal permission: Android grants it at install, without asking. The app has no
         other permission (see PRIVACY.md). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- enableOnBackInvokedCallback: without it, Android 16 and later handle the back button
         themselves (predictive back) and the app never sees it; android.rs makes it close
         what is open, or else leave the app. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="false"
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="CalcCraft"
        android:theme="@style/CalcCraft">

        <!-- The app handles every configuration change itself: a restarted activity would
             start a second winit event loop, which winit doesn't allow. A rotation only
             changes the window's size. The orientation is Settings → Screen orientation's
             (android.rs set_orientation), so none is fixed here. The keyboard pans the screen
             instead of shrinking it, for the same reason. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <meta-data
                android:name="android.app.lib_name"
                android:value="calculator" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
