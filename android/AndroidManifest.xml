<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app: Android's NativeActivity loads libcalculator.so (the Rust library, see
     src/lib.rs) and its android_main runs the app. build-apk.ps1 adds
     the version from Cargo.toml (see README.md). The only Java code is ShareProvider (java/),
     for the graph's Share: build-apk.ps1 compiles it, and fills in ${applicationId}. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rapalon.calccraft">

    <!-- The keys' tap of the vibration motor (Settings → Key vibration, android.rs key_tap).
         A normal permission: Android grants it at install, without asking. The app has no
         other permission (see PRIVACY.md). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- enableOnBackInvokedCallback: without it, Android 16 and later handle the back button
         themselves (predictive back) and the app never sees it; android.rs makes it close
         what is open, or else leave the app. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CalcCraft"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/CalcCraft">

        <!-- One activity, one process (README.md, "One activity, one process"): winit allows
             one event loop per process and ignores onDestroy, so the activity must neither be
             restarted nor created twice.
             - configChanges names every configuration change an app can declare: a restarted
               activity froze the app (Bold text, fontWeightAdjustment, did). A rotation only
               changes the window's size. The orientation is Settings → Screen orientation's
               (android.rs set_orientation), so none is fixed here. The keyboard pans the screen
               instead of shrinking it, for the same reason.
             - singleTask: an intent for the running activity (am start -n, a test crawler)
               goes to it instead of stacking a second one, which ended the app.
             - func_name: NativeActivity calls calccraft_on_create (src/lib.rs), which ends the
               process on a destroy that can't be avoided (an overlay change) instead of
               freezing.
             tests/android_manifest.rs checks all three. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan">
            <meta-data
                android:name="android.app.lib_name"
                android:value="calculator" />
            <meta-data
                android:name="android.app.func_name"
                android:value="calccraft_on_create" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The graph's picture for the app picked in the share sheet (android.rs
             share_image): one read-only file of the cache. Not exported; the share intent
             grants the picked app that one URI. The authority follows the application ID, so
             CalcCraft and CalcCraft Pro can be installed side by side. -->
        <provider
            android:name="com.rapalon.calccraft.ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
