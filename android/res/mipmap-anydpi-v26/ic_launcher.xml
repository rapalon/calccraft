<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (Android 8 and later): the calculator over the icon's blue,
     cropped to the launcher's shape, and its silhouette for Android 13's themed icons. The
     layers are tools/app-icon.py's, from the PNGs in android/icon-source/. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
